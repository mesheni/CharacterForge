  "features": {
    "1": [
      {
        "id": "spellcasting",
        "name": "Spellcasting",
        "ru": "Сотворение заклинаний",
        "url": "https://next.dnd.su/class/artificer#feature.spellcasting",
        "detail": "Интеллект определяет модификатор магии. Для сотворения заклинаний нужны освоенные инструменты. Все ячейки восстанавливаются после долгого отдыха."
      },
      {
        "id": "tinkers-magic",
        "name": "Tinker's Magic",
        "ru": "Магия вещей",
        "url": "https://next.dnd.su/class/artificer#feature.tinkers-magic",
        "detail": "Вы знаете заговор «Починка». Инструменты ремонтника помогают временно создать один из обыденных предметов."
      }
    ],
    "2": [
      {
        "id": "replicate-magic-item",
        "name": "Replicate Magic Item",
        "ru": "Реплики магических предметов",
        "url": "https://next.dnd.su/class/artificer#feature.replicate-magic-item",
        "detail": "На 2-м уровне выберите четыре схемы. После долгого отдыха можно создавать предметы по известным схемам в пределах указанного количества. Один экземпляр каждой схемы одновременно."
      }
    ],
